{
  "extends": "./tsconfig.json",  "compilerOptions": {
    "module": "NodeNext",
    "outDir": "dist",
    "target": "esnext", 
    "moduleResolution": "NodeNext",
    "isolatedModules": false,
    "allowJs": true,
    "noEmit": false
  },
  "include": ["fastify-entry.ts", "server/**/*", "api/**/*", "api-server.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
